---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_AUTHOR, GITHUB_URL } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`about — ${SITE_TITLE}`} description={`About ${SITE_AUTHOR}.`} />
	</head>
	<body>
		<Header />
		<main>
			<article class="prose">
				<h1>About</h1>
				<p>
					Hi, I'm {SITE_AUTHOR}. This page is a placeholder. Write it yourself; it is the one
					page on the site that should not be delegated.
				</p>
				<p>
					Reach me on <a href={GITHUB_URL} rel="me noopener">GitHub</a>.
				</p>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.prose {
		max-width: 62ch;
	}
</style>
